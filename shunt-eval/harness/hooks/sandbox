#!/bin/bash
# Harness sandbox hook, applied identically to every arm via `claude -p --settings harness/settings.json`.
# The evaluation is "answer from this repository, offline": Spotify's monorepo is private, so a model that
# fetches the file from GitHub, finds another checkout on the machine, or reads the harness's own results
# is not doing what a Spotify engineer's session could do. Blocks:
#   Bash    : network commands (curl, wget, git clone/fetch/pull, pip/npm installs, ssh, URLs), filesystem
#             walks from "/", and any absolute path outside the workspace, the session's private /tmp
#             (run.py gives every session an empty tmpfs /tmp) or the usual system prefixes
#   Read/Grep/Glob : any path outside the workspace
# Everything inside the workspace is untouched, so the arms' own hooks behave exactly as before.
input=$(cat)
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty')
ws="${CLAUDE_PROJECT_DIR:-$PWD}"
reason="This evaluation is offline and limited to the repository checked out at $ws. Answer from the files in it."
block() { printf '{"decision": "block", "reason": "%s"}\n' "$reason"; exit 0; }
allow() { echo '{"decision": "allow"}'; exit 0; }
case "$tool" in
  Bash)
    cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty')
    printf '%s' "$cmd" | grep -qE '(^|[^A-Za-z0-9_])(curl|wget|ssh|scp|nc|ncat|telnet|pip3?|npm|npx|yarn|apt(-get)?)([[:space:]]|$)' && block
    printf '%s' "$cmd" | grep -qE 'git[[:space:]]+(-C[[:space:]]+[^[:space:]]+[[:space:]]+)?(clone|fetch|pull|ls-remote|remote|submodule)' && block
    printf '%s' "$cmd" | grep -qiE 'https?://|ftp://|ssh://' && block
    # a bare "/" as a command argument (find / , ls / , cd / , grep -r ... /): checked with quoted strings
    # removed, so "a / b" inside a quoted question or grep pattern is not mistaken for the root
    stripped=$(printf '%s' "$cmd" | sed -E "s/\"[^\"]*\"//g; s/'[^']*'//g")
    printf '%s' "$stripped" | grep -qE '(^|[[:space:]])/([[:space:]]|$)' && block
    # absolute paths (at least one character after the slash, so "a / b" in prose is not a path):
    # allow the workspace, the session's private /tmp, and system prefixes only
    # unquoted absolute paths, plus quoted strings that are nothing but a path ("/x/y"); quoted prose and
    # regexes like '/pattern/,/end/' are not paths
    quoted_paths=$(printf '%s' "$cmd" | grep -oE '"/[A-Za-z0-9_./-]+"|'"'"'/[A-Za-z0-9_./-]+'"'"'' | tr -d "\"'")
    for p in $(printf '%s' "$stripped" | grep -oE '(^|[[:space:]=(>])/[A-Za-z0-9_.-][A-Za-z0-9_./-]*' | sed -E 's/^[[:space:]=(>]//') $quoted_paths; do
      case "$p" in
        /tmp/claude-*) block ;;
        "$ws"|"$ws"/*|/tmp|/tmp/*|/usr/*|/bin/*|/sbin/*|/lib*|/etc/*|/dev/*|/proc/*|/sys/*|/opt/*|/var/lib/*|/home/*/.gradle/*|/root/.gradle/*) ;;
        *) block ;;
      esac
    done
    allow ;;
  Read|Grep|Glob)
    p=$(printf '%s' "$input" | jq -r '.tool_input.file_path // .tool_input.path // empty')
    [ -z "$p" ] && allow
    case "$p" in
      /*) case "$p" in /tmp/claude-*) block ;; "$ws"|"$ws"/*|/tmp/*) allow ;; *) block ;; esac ;;
      *) allow ;;
    esac ;;
  *) allow ;;
esac
